set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(DFRE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${DFRE_ROOT}/scripts/zig-cc")
set(CMAKE_CXX_COMPILER "${DFRE_ROOT}/scripts/zig-cxx")
set(CMAKE_C_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_AR "${DFRE_ROOT}/scripts/zig-ar")
set(CMAKE_RANLIB "${DFRE_ROOT}/scripts/zig-ranlib")
set(CMAKE_RC_COMPILER "${DFRE_ROOT}/scripts/zig-rc")
set(CMAKE_RC_COMPILE_OBJECT "<CMAKE_RC_COMPILER> <DEFINES> <INCLUDES> /fo <OBJECT> <SOURCE>")
set(CMAKE_CROSSCOMPILING_EMULATOR "${DFRE_ROOT}/scripts/wine")
