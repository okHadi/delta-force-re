#!/bin/sh
set -eu
for arg in "$@"; do
    case "$arg" in
        -m|--model|--model=*|-m?*)
            echo 'Worker model is fixed to opencode-go/deepseek-v4.1-flash.' >&2
            exit 2
            ;;
    esac
done
exec opencode run --standalone --model opencode-go/deepseek-v4.1-flash#max --format json "$@"
